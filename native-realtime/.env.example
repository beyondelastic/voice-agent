# ---------------------------------------------------------------------------
# Copy this file to ".env" and fill in your own values.
# Native mode accepts EITHER Microsoft Entra ID (run `az login`) OR an API key.
# ---------------------------------------------------------------------------

# Voice Live endpoint of your Microsoft Foundry resource.
# Found under "Keys and Endpoint" in the Azure portal. Example:
#   https://<your-resource>.cognitiveservices.azure.com/
AZURE_VOICELIVE_ENDPOINT=

# --- Optional -------------------------------------------------------------

# Native speech-to-speech model. No deployment needed — Voice Live manages it.
AZURE_VOICELIVE_MODEL=gpt-realtime

# Native model voice: alloy, echo, fable, onyx, nova, shimmer, marin, cedar.
VOICE_NAME=alloy

# The agent's "personality"/behaviour — the custom part, defined here (not in a
# Foundry agent). Leave unset to use the built-in VitalCare health-insurance
# assistant persona in voice_realtime.py.
# INSTRUCTIONS=You are Clara, a voice assistant for VitalCare Health Insurance...

# API key (optional). If set, it is used instead of Entra ID / az login.
# AZURE_VOICELIVE_API_KEY=

# API version. Leave unset to use the SDK default.
# AZURE_VOICELIVE_API_VERSION=
