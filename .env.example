# ---------------------------------------------------------------------------
# Copy this file to ".env" and fill in your own values.
# Agent mode requires Microsoft Entra ID (run `az login` first) — API keys are
# NOT supported when connecting to a Foundry agent.
# ---------------------------------------------------------------------------

# --- Used by voice_agent.py (talking to the agent) -------------------------

# Voice Live endpoint of your Microsoft Foundry resource.
# Found under "Keys and Endpoint" in the Azure portal. Example:
#   https://<your-resource>.cognitiveservices.azure.com/
AZURE_VOICELIVE_ENDPOINT=

# The name of the Foundry agent you want to talk to.
AGENT_NAME=MyVoiceAgent

# The name of the Foundry project that contains the agent.
# This is the LAST path segment of your project endpoint.
AGENT_PROJECT_NAME=

# --- Optional -------------------------------------------------------------

# Pin a specific agent version. Omit to always use the latest.
# AGENT_VERSION=

# Continue an earlier conversation by its id.
# AGENT_CONVERSATION_ID=

# Voice used for the spoken response.
AGENT_VOICE=en-US-Ava:DragonHDLatestNeural

# API version for the agent connection. Leave unset to use the SDK default
# (2026-04-10 on GA 1.2.0, 2026-07-15 on the 1.3.0 preview). Only set this to
# pin a specific service API version, e.g. when evaluating 1.3.
# AZURE_VOICELIVE_API_VERSION=2026-07-15

# --- Used only by create_agent.py (creating the agent) --------------------

# Full Foundry project endpoint, copied from the project welcome screen.
# Example: https://<resource>.services.ai.azure.com/api/projects/<project>
PROJECT_ENDPOINT=

# Model deployment the agent should use.
MODEL_DEPLOYMENT_NAME=gpt-5-mini
